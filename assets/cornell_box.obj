f 3//3 4//3 8//3 7//3

# Left wall (x = 0, normal = +x, red)
usemtl red
f 1//4 5//4 8//4 4//4

# Right wall (x = 1, normal = -x, green)
usemtl green
f 2//5 3//5 7//5 6//5

# Light patch (y = 1, normal = -y)
usemtl light
f 9//2 10//2 11//2 12//2

